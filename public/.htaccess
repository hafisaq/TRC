# Caching contract for a hashed-asset SPA:
# - HTML and the service worker must always revalidate (a stale index.html
#   references hashed bundles that no longer exist after the next deploy —
#   the page then boots blank or serves last week's app)
# - hashed /assets are immutable forever
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|mp4|pdf|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(sw\.js|manifest\.webmanifest|sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
